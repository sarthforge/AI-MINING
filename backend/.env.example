# Copy to backend/.env and fill in from Supabase Project Settings.
# Never commit backend/.env or put SUPABASE_SERVICE_ROLE_KEY in the frontend.

SUPABASE_DB_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
NDVI_DROP_THRESHOLD=0.3
MAX_CLOUD_PCT=20
STAC_URL=https://earth-search.aws.element84.com/v1
STORAGE_BUCKET=imagery
# Directory with {siteId}_baseline.tif and {siteId}_current.tif (2-band: red, NIR) as STAC fallback
NDVI_RASTER_DIR=
CORS_ORIGINS=http://localhost:5173,https://<your-app>.vercel.app
